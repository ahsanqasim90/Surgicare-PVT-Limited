{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run install:all && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 10 }
  }
}
